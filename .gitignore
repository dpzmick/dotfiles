*.swp
*.pyc
.DS_Store

# put these here as to not interfere with doom's own gitignore
emacs/emacs.d.symlink/.lsp-session-v1
emacs/emacs.d.symlink/autosave/
emacs/emacs.d.symlink/backups/
emacs/emacs.d.symlink/custom.el
emacs/emacs.d.symlink/places
emacs/emacs.d.symlink/savehist
emacs/emacs.d.symlink/straight/
emacs/emacs.d.symlink/transient/

# systemd user units that embed healthchecks ping urls
config.symlink/systemd/user/mbsync.service
config.symlink/systemd/user/nas_backup.service
config.symlink/systemd/user/r2e.service
config.symlink/systemd/user/vdirsync.service
# per-machine enablement symlinks
config.symlink/systemd/user/*.wants/

# local credentials and backups under ~/.config (config.symlink is ~/.config on worf)
config.symlink/omada/openapi.env
config.symlink/omada/.token
config.symlink/omada/backup/
config.symlink/grafana/

# app state that lands in ~/.config on worf (not dotfiles)
config.symlink/TvB/
config.symlink/borg/
config.symlink/btop/
config.symlink/cni/
config.symlink/ghb/
config.symlink/go/
config.symlink/incus/
config.symlink/libvirt/
config.symlink/rss2email.cfg
