# systemd user units that embed healthchecks ping urls
config.symlink/systemd/user/mbsync.service
config.symlink/systemd/user/nas_backup.service
config.symlink/systemd/user/r2e.service
config.symlink/systemd/user/vdirsync.service
# per-machine enablement symlinks
config.symlink/systemd/user/*.wants/
